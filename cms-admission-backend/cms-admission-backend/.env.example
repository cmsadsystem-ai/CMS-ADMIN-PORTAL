# Copy this file to .env and fill in your values.

# ---- Database ----
# Cloud Postgres (Neon / Supabase / Render / Railway).
# postgresql+psycopg2://user:password@host/dbname?sslmode=require
# Leave empty to use a local SQLite file for quick testing only.
DATABASE_URL=postgresql://postgres:GOKULNATH@CMSCE@db.ozahozfrcmqnryzygmtl.supabase.co:5432/postgres

# ---- Frontend ----
# Kiosk/staff dashboard origins allowed to call this API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base URL the mobile browser will open when it scans the kiosk QR code.
# Must be reachable from a phone on campus wifi - NOT 127.0.0.1/localhost in production.
MOBILE_UPLOAD_BASE_URL=http://localhost:5173/upload

# ---- Security ----
# Random secret for staff login JWTs. Generate: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me-dev-only
JWT_EXPIRE_MINUTES=480

# Fernet key used to encrypt Aadhaar numbers at rest.
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AADHAAR_ENC_KEY=

# QR / mobile-upload session tokens expire after this many minutes.
UPLOAD_TOKEN_EXPIRE_MINUTES=120

# Where uploaded documents are written on disk (swap for S3 etc. later - see app/storage.py).
UPLOAD_DIR=./uploads

# One-time bootstrap admin account (created automatically if no staff user exists yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ---- Email / SMTP Configuration ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cmsadsystem@gmail.com
SMTP_PASSWORD=your-gmail-16-char-app-password
SMTP_FROM=cmsadsystem@gmail.com
SMTP_TLS=True
FRONTEND_BASE_URL=http://localhost:5173

